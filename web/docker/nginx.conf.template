# Gerado a partir de um template: ${API_UPSTREAM} é substituído na inicialização.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  server_tokens off;
  # Uploads de imagem (limite da API: 2 MB por padrão) + folga do multipart.
  client_max_body_size 12m;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # Cabeçalhos de segurança ficam só nas rotas estáticas: no nível "server" o
  # nginx os herdaria no proxy e duplicaria os que o Helmet já envia na API.

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # --- API e imagens: proxy para o container da API ---------------------------
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 30s;
  }

  location /uploads/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
  }

  location /health/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
  }

  # --- Arquivos do Vite com hash no nome: cache longo --------------------------
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # --- SPA: rotas do React Router caem no index.html ---------------------------
  location / {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    try_files $uri $uri/ /index.html;
  }
}
