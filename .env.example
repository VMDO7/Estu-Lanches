# =============================================================================
# Variáveis do docker-compose (opcional)
# Copie para `.env` na raiz para sobrescrever os padrões do docker-compose.yml.
# Para rodar sem Docker, use server/.env (veja server/.env.example).
# =============================================================================

# Portas no host
WEB_PORT=8080
DB_PORT=5433

# Banco (container)
POSTGRES_USER=estulanches
POSTGRES_PASSWORD=estulanches
POSTGRES_DB=estulanches

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Conta administradora criada no primeiro start
SEED_ADMIN_EMAIL=admin@estulanches.com.br
SEED_ADMIN_PASSWORD=Admin12345

# Dados de demonstração (produtos, alunos e pedidos fictícios)
SEED_DEMO=true
SEED_DEMO_PASSWORD=Aluno12345
DEMO_MODE=true
