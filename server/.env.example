# =============================================================================
# EstuLanches API — variáveis de ambiente
# Copie para `.env` e preencha. Nunca versione o arquivo .env.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
PORT=3333
# Fuso usado em relatórios ("hoje", "semana") e no dashboard
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL) ---------------------------------------------
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/estulanches?schema=public

# --- Autenticação -------------------------------------------------------------
# Gere um segredo forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Validade do access token (segundos) e do refresh token (dias)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- HTTP ----------------------------------------------------------------------
# Origens autorizadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Atrás de proxy/load balancer: número de saltos confiáveis (ex.: 1) ou "true"
TRUST_PROXY=false

# --- Uploads de imagens -------------------------------------------------------
UPLOADS_DIR=uploads
# URL pública base das imagens (troque por uma CDN em produção)
PUBLIC_UPLOADS_URL=/uploads
MAX_UPLOAD_SIZE_MB=2

# --- Demonstração ---------------------------------------------------------------
# Quando "true", a interface exibe o selo "Ambiente de demonstração"
DEMO_MODE=false

# --- Seeds ----------------------------------------------------------------------
# Conta administradora criada por `npm run db:seed`
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Senha das contas de estudantes criadas por `npm run db:seed:demo`
SEED_DEMO_PASSWORD=
